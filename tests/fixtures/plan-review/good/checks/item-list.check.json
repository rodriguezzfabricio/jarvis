{
  "name": "item-list",
  "criteria": [
    "AC3"
  ],
  "cases": [
    {
      "id": "reset",
      "command": "rm -f data/check-items.jsonl"
    },
    {
      "id": "empty",
      "command": "ITEMS_FILE=data/check-items.jsonl node src/cli.mjs list"
    },
    {
      "id": "first",
      "command": "ITEMS_FILE=data/check-items.jsonl node src/cli.mjs add exercise"
    },
    {
      "id": "second",
      "command": "ITEMS_FILE=data/check-items.jsonl node src/cli.mjs add \"buy milk\""
    },
    {
      "id": "list",
      "command": "ITEMS_FILE=data/check-items.jsonl node src/cli.mjs list"
    },
    {
      "id": "extra",
      "command": "ITEMS_FILE=data/check-items.jsonl node src/cli.mjs list unexpected"
    },
    {
      "id": "default",
      "command": "isolated=$(mktemp -d) && cp -R src \"$isolated/src\" && mkdir \"$isolated/data\" && printf '{\"name\":\"exercise\"}\\n' > \"$isolated/data/items.jsonl\" && env -u ITEMS_FILE node \"$isolated/src/cli.mjs\" list && ITEMS_FILE= node \"$isolated/src/cli.mjs\" list"
    },
    {
      "id": "read-error",
      "command": "ITEMS_FILE=data node src/cli.mjs list"
    },
    {
      "id": "malformed",
      "command": "printf 'not json\\n' > data/check-items.jsonl && ITEMS_FILE=data/check-items.jsonl node src/cli.mjs list"
    }
  ],
  "verify": "sh \"$JARVIS_CHECKS/verify-list.sh\"",
  "timeoutMs": 60000
}
