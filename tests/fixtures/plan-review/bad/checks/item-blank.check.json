{
  "name": "item-blank",
  "criteria": [
    "AC2"
  ],
  "cases": [
    {
      "id": "reset",
      "command": "rm -f data/check-blank.jsonl"
    },
    {
      "id": "seed",
      "command": "ITEMS_FILE=data/check-blank.jsonl node src/cli.mjs add keep"
    },
    {
      "id": "blank",
      "command": "ITEMS_FILE=data/check-blank.jsonl node src/cli.mjs add \"  \""
    },
    {
      "id": "missing",
      "command": "ITEMS_FILE=data/check-blank.jsonl node src/cli.mjs add"
    },
    {
      "id": "newline",
      "command": "ITEMS_FILE=data/check-blank.jsonl node src/cli.mjs add \"$(printf 'buy\\nmilk')\""
    },
    {
      "id": "cr",
      "command": "ITEMS_FILE=data/check-blank.jsonl node src/cli.mjs add \"$(printf 'buy\\rmilk')\""
    },
    {
      "id": "file",
      "command": "cat data/check-blank.jsonl 2>/dev/null || true"
    }
  ],
  "verify": "sh \"$JARVIS_CHECKS/verify-blank.sh\"",
  "timeoutMs": 60000
}
